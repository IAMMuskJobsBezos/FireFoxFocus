<!-- Landscape variant of the Elderberry backdrop. Same gradient and same 160deg angle as the
     portrait drawable, with the gradient line re-solved for an 844x390 frame:
       length    = 844*0.34202 + 390*0.93969 = 655.14
       endpoints = centre (422, 195) -/+ (length / 2) * (0.34202, 0.93969) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="844dp"
    android:height="390dp"
    android:viewportWidth="844"
    android:viewportHeight="390">
  <path
      android:pathData="M844,390V0H0V390H844Z"
      android:fillType="evenOdd">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="309.97"
          android:startY="-112.81"
          android:endX="534.03"
          android:endY="502.81">
        <item android:offset="0" android:color="#6b4574"/>
        <item android:offset="0.55" android:color="#4a2c58"/>
        <item android:offset="1" android:color="#2a1633"/>
      </gradient>
    </aapt:attr>
  </path>
</vector>
