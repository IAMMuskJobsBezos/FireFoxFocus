<!-- Elderberry start-page backdrop, from the design system's bg-gradient token:
     linear-gradient(160deg, #6b4574 0%, #4a2c58 55%, #2a1633 100%).

     The viewport is the design's own 390x844 reference frame, and the start/end points are the
     CSS gradient line solved for that frame, so the 160deg angle is exact rather than snapped to
     a multiple of 45 (which is all <shape><gradient android:angle> would allow):
       direction = (sin 160, -cos 160) = (0.34202, 0.93969)
       length    = 390*0.34202 + 844*0.93969 = 926.49
       endpoints = centre (195, 422) -/+ (length / 2) * direction

     Deliberately shared by light and dark: there is one Elderberry gradient, so the night
     variants of this drawable were removed rather than given a separate palette. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="390dp"
    android:height="844dp"
    android:viewportWidth="390"
    android:viewportHeight="844">
  <path
      android:pathData="M390,844V0H0V844H390Z"
      android:fillType="evenOdd">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="36.56"
          android:startY="-13.24"
          android:endX="353.44"
          android:endY="857.24">
        <item android:offset="0" android:color="#6b4574"/>
        <item android:offset="0.55" android:color="#4a2c58"/>
        <item android:offset="1" android:color="#2a1633"/>
      </gradient>
    </aapt:attr>
  </path>
</vector>
